{
  "name": "cantare",
  "version": "1.1.0",
  "private": true,
  "description": "A static songbook built with Astro, Pagefind and ChordSheetJS",
  "license": "MIT",
  "bin": {
    "cantare": "./bin/cantare.js"
  },
  "files": [
    "bin",
    "src",
    "astro.config.mjs",
    "site.config.json",
    "tsconfig.json"
  ],
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@tombatossals/chords-db": "^0.5.1",
    "astro": "^7.4.11",
    "astro-pagefind": "^2.0.1",
    "chordsheetjs": "^16.2.2",
    "pagefind": "^1.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "^0.5.3",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,mjs,ts,astro}": "oxlint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "aube": {
    "allowBuilds": {
      "esbuild": true,
      "sharp": true
    }
  }
}
