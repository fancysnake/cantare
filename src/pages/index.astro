---
import RandomButton from '../components/RandomButton.astro';
import Base from '../layouts/Base.astro';
import { allSongs, routes } from '../lib/inits/pages';
import { locale, t } from '../lib/inits/site';

const songs = await allSongs();
---

<Base>
  <link rel="stylesheet" href={routes.url('/pagefind/pagefind-component-ui.css')} />
  <script is:inline type="module" src={routes.url('/pagefind/pagefind-component-ui.js')}></script>
  {/* Pagefind indexes paths relative to the build output, so under a base it
      needs both told to it: where the bundle lives, and what to prefix results
      with. Both are no-ops when the base is `/`. */}
  <pagefind-config
    instance="songs"
    bundle-path={routes.url('/pagefind/')}
    base-url={routes.homeHref()}
  ></pagefind-config>
  {/* Pagefind ships only sparse translations for many locales, so override its
      UI strings from our own i18n table (keys are Pagefind's). The component
      exposes the instance on the element once it has initialised. */}
  <script is:inline type="module" define:vars={{ searchUi: t.searchUi }}>
    await customElements.whenDefined('pagefind-input');
    const find = () => document.querySelector('pagefind-input[instance="songs"]');
    let el = find();
    for (let i = 0; i < 60 && !el?.instance; i += 1) {
      await new Promise((r) => requestAnimationFrame(r));
      el = find();
    }
    el?.instance?.setTranslations(searchUi);
    // Results stay inside the active songbook; an empty list lifts the filter.
    const applySongbook = () => {
      const active = document.documentElement.dataset.songbook;
      el?.instance?.triggerFilter('songbook', active ? [active] : []);
    };
    applySongbook();
    document.addEventListener('songbook:changed', applySongbook);
  </script>
  <pagefind-input
    instance="songs"
    lang={locale}
    placeholder={t.searchUi.placeholder}
  ></pagefind-input>
  <div class="search-filters">
    <pagefind-filter-dropdown
      filter="artist"
      label={t.filterArtist}
      instance="songs"
    ></pagefind-filter-dropdown>
    <pagefind-filter-dropdown
      filter="album"
      label={t.filterAlbum}
      instance="songs"
    ></pagefind-filter-dropdown>
    <pagefind-filter-dropdown
      filter="tag"
      label={t.filterTag}
      instance="songs"
    ></pagefind-filter-dropdown>
    <pagefind-filter-dropdown
      filter="language"
      label={t.filterLanguage}
      instance="songs"
    ></pagefind-filter-dropdown>
  </div>
  <pagefind-summary instance="songs" default-message={t.searchDefault}></pagefind-summary>
  <pagefind-results instance="songs"></pagefind-results>
  <noscript>
    {t.searchNoscript} <a href={routes.songsHref()}>{t.browseAllSongs}</a>.
  </noscript>

  <p class="home-actions">
    <RandomButton songs={songs} />
    <a href={routes.songsHref()}>{t.navAllSongs}</a>
  </p>
</Base>

<style>
  .search-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.75rem 0;
  }

  .home-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }
</style>
