---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SongList from '../../components/SongList.astro';
import RandomButton from '../../components/RandomButton.astro';
import SongbookFilters from '../../components/SongbookFilters.astro';
import { groupBySlug } from '../../lib/facets';
import { t } from '../../lib/i18n';

export async function getStaticPaths() {
  const songs = await getCollection('songs');
  const byArtist = groupBySlug(songs, (song) => [song.data.artist]);
  return [...byArtist.entries()].map(([slug, props]) => ({ params: { slug }, props }));
}

interface Props {
  name: string;
  songs: CollectionEntry<'songs'>[];
}

const { name, songs } = Astro.props;
---

<Base title={name}>
  <h1 data-pagefind-body data-pagefind-meta={`title:${t.artistMeta}: ${name}`}>
    {name}
    <SongbookFilters songs={songs} />
  </h1>
  <SongList songs={songs} />
  <RandomButton songs={songs} />
</Base>
