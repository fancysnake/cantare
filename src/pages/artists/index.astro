---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ListingItem from '../../components/ListingItem.astro';
import { groupBySlug } from '../../lib/facets';
import { t } from '../../lib/i18n';
import { artistHref } from '../../lib/routes';

const songs = await getCollection('songs');

const artists = groupBySlug(songs, 'artists');
---

<Base title={t.artistsTitle}>
  <h1>{t.artistsTitle}</h1>
  <ul class="song-list">
    {artists.map(({ name, songs }) => (
      <ListingItem href={artistHref(name)} label={name} songs={songs} />
    ))}
  </ul>
</Base>
