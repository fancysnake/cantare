---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ListingItem from '../../components/ListingItem.astro';
import { slugify } from '../../lib/slug';
import { locale, t } from '../../lib/i18n';
import { languageHref } from '../../lib/routes';

const songs = await getCollection('songs');

const languages = new Map<string, { name: string; songs: CollectionEntry<'songs'>[] }>();
for (const song of songs) {
  const name = song.data.language;
  if (!name) continue;
  const slug = slugify(name);
  const entry = languages.get(slug) ?? { name, songs: [] };
  entry.songs.push(song);
  languages.set(slug, entry);
}

const sorted = [...languages.entries()].sort((a, b) => a[1].name.localeCompare(b[1].name, locale));
---

<Base title={t.languagesTitle}>
  <h1>{t.languagesTitle}</h1>
  <ul class="song-list">
    {sorted.map(([, { name, songs }]) => (
      <ListingItem href={languageHref(name)} label={name} songs={songs} />
    ))}
  </ul>
</Base>
