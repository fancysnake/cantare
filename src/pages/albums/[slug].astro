---
import type { CollectionEntry } from 'astro:content';

import type { Facet } from '../../lib/pacts/songbook';

import RandomButton from '../../components/RandomButton.astro';
import SongbookFilters from '../../components/SongbookFilters.astro';
import SongList from '../../components/SongList.astro';
import Base from '../../layouts/Base.astro';
import { facets } from '../../lib/inits/pages';
import { t } from '../../lib/inits/site';

export async function getStaticPaths() {
  return (await facets('albums')).map((props) => ({
    params: { slug: props.slug },
    props,
  }));
}

type Props = Facet<CollectionEntry<'songs'>>;

const { name, songs } = Astro.props;
---

<Base title={name}>
  <h1 data-pagefind-body data-pagefind-meta={`title:${t.albumMeta}: ${name}`}>
    {name}
    <SongbookFilters songs={songs} />
  </h1>
  <SongList songs={songs} />
  <RandomButton songs={songs} />
</Base>
