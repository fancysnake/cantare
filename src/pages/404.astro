---
import Base from '../layouts/Base.astro';
import { routes } from '../lib/inits/pages';
import { t } from '../lib/inits/site';
---

<Base title={t.notFoundTitle}>
  <h1>{t.notFoundHeading}</h1>
  <p>
    {t.notFoundBefore}
    <a href={routes.homeHref()}>{t.notFoundSearch}</a>
    {t.notFoundOr}
    <a href={routes.songsHref()}>{t.notFoundBrowse}</a>.
  </p>
</Base>
