---
import Base from '../layouts/Base.astro';
import { t } from '../lib/i18n';
import { url } from '../lib/site';
---

<Base title={t.notFoundTitle}>
  <h1>{t.notFoundHeading}</h1>
  <p>
    {t.notFoundBefore}
    <a href={url('/')}>{t.notFoundSearch}</a>
    {t.notFoundOr}
    <a href={url('/songs/')}>{t.notFoundBrowse}</a>.
  </p>
</Base>
