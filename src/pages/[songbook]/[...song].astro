---
import { getCollection } from 'astro:content';
import { site } from '../../lib/site';
import { songbookOptions } from '../../lib/songbook';
import { homeHref, songHref } from '../../lib/routes';
import { locale, t } from '../../lib/i18n';

// The page behind `songbookHref`: it makes the songbook active, then lands on the page it names.
export async function getStaticPaths() {
  const songs = await getCollection('songs');
  return songbookOptions(site.songbooks, songs, t.songbookOther).flatMap(({ slug }) => [
    { params: { songbook: slug, song: undefined }, props: { songbook: slug, target: homeHref() } },
    ...songs
      .filter((song) => song.data.songbooks.includes(slug))
      .map((song) => ({
        params: { songbook: slug, song: song.id },
        props: { songbook: slug, target: songHref(song.id) },
      })),
  ]);
}

interface Props {
  songbook: string;
  target: string;
}

const { songbook, target } = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{site.name}</title>
    <script is:inline define:vars={{ songbook, target }}>
      localStorage.setItem('songbook', songbook);
      location.replace(target);
    </script>
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${target}`} />
    </noscript>
  </head>
  <body>
    <a href={target}>{site.name}</a>
  </body>
</html>
