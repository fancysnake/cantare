---
import ListingItem from '../../components/ListingItem.astro';
import Base from '../../layouts/Base.astro';
import { tagHref, facets } from '../../lib/inits/pages';
import { t } from '../../lib/inits/site';

const tags = await facets('tags');
---

<Base title={t.tagsTitle}>
  <h1>{t.tagsTitle}</h1>
  <ul class="song-list">
    {tags.map(({ name, songs }) => (
      <ListingItem href={tagHref(name)} label={`#${name}`} songs={songs} />
    ))}
  </ul>
</Base>
