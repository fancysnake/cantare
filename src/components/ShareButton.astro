---
import { t } from '../lib/i18n';
---

<button id="share-link" class="btn" hidden>
  🔗 {t.shareLink}
</button>

<script>
  import { t } from '../lib/i18n';

  const shareButton = document.getElementById('share-link');
  if (shareButton) {
    const label = shareButton.textContent;
    shareButton.addEventListener('click', () => {
      // Base's pre-paint script activates `?songbook=` and strips it from the address bar.
      const url = new URL(location.href);
      url.searchParams.set('songbook', document.documentElement.dataset.songbook ?? '');
      const link = url.href;
      navigator.clipboard.writeText(link).then(
        () => {
          shareButton.textContent = `✓ ${t.shareCopied}`;
          setTimeout(() => (shareButton.textContent = label), 2000);
        },
        () => prompt(t.shareLink, link),
      );
    });
    shareButton.hidden = false;
  }
</script>

<style>
  /* With no songbook active the page's own link already says everything. */
  :global(:root:not([data-songbook])) #share-link {
    display: none;
  }
</style>
