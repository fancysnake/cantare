---
import type { CollectionEntry } from 'astro:content';
import { t } from '../lib/i18n';
import { songLink, type RandomLink } from '../lib/routes';

interface Props {
  songs: CollectionEntry<'songs'>[];
  label?: string | undefined;
}

const { songs, label = t.randomSong } = Astro.props;
const links = songs.map((song): RandomLink => ({
  ...songLink(song),
  songbooks: song.data.songbooks,
}));
const songbooks = [...new Set(songs.flatMap((song) => song.data.songbooks))].join(' ');
---

<button
  class="btn random-pick"
  hidden
  data-links={JSON.stringify(links)}
  data-songbooks={songbooks || undefined}
>
  🎲 {label}
</button>

<script>
  import type { RandomLink } from '../lib/routes';

  document.querySelectorAll<HTMLButtonElement>('button.random-pick').forEach((button) => {
    button.hidden = false;
    button.addEventListener('click', () => {
      const all: RandomLink[] = JSON.parse(button.dataset.links ?? '[]');
      const active = document.documentElement.dataset.songbook;
      const links = active ? all.filter((link) => link.songbooks.includes(active)) : all;
      const link = links[Math.floor(Math.random() * links.length)];
      if (link?.target) window.open(link.href, link.target, 'noopener');
      else if (link) window.location.href = link.href;
    });
  });
</script>

<style>
  .random-pick {
    padding: 0.4rem 0.9rem;
  }

  @media print {
    .random-pick {
      display: none;
    }
  }
</style>
