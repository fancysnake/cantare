---
import { t } from '../lib/i18n';
import type { SongLink } from '../lib/routes';

interface Props {
  links: SongLink[];
  label?: string | undefined;
}

const { links, label = t.randomSong } = Astro.props;
---

<button class="btn random-pick" hidden data-links={JSON.stringify(links)}>
  🎲 {label}
</button>

<script>
  import type { SongLink } from '../lib/routes';

  document.querySelectorAll<HTMLButtonElement>('button.random-pick').forEach((button) => {
    button.hidden = false;
    button.addEventListener('click', () => {
      const links: SongLink[] = JSON.parse(button.dataset.links ?? '[]');
      const link = links[Math.floor(Math.random() * links.length)];
      if (link?.target) window.open(link.href, link.target, 'noopener');
      else if (link) window.location.href = link.href;
    });
  });
</script>

<style>
  .random-pick {
    padding: 0.4rem 0.9rem;
  }

  @media print {
    .random-pick {
      display: none;
    }
  }
</style>
