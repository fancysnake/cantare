---
import type { CollectionEntry } from 'astro:content';
import { locale } from '../lib/i18n';
import { songLink } from '../lib/routes';
import { songbooks } from '../lib/site';
import { songbooksOf } from '../lib/songbook';
import ExternalCue from './ExternalCue.astro';

interface Props {
  songs: CollectionEntry<'songs'>[];
}

const songs = [...Astro.props.songs].sort((a, b) =>
  a.data.title.localeCompare(b.data.title, locale),
);
---

<ul class="song-list">
  {songs.map((song) => {
    const link = songLink(song);
    return (
      <li data-songbooks={songbooksOf(song.data, songbooks).join(' ') || undefined}>
        <a {...link}>
          {song.data.title}
          {link.target && <ExternalCue />}
        </a>
        <span class="song-meta"> — {song.data.artist}</span>
      </li>
    );
  })}
</ul>
