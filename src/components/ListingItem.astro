---
import type { CollectionEntry } from 'astro:content';
import { t } from '../lib/i18n';

interface Props {
  href: string;
  label: string;
  songs: CollectionEntry<'songs'>[];
}

const { href, label, songs } = Astro.props;
const counts: Record<string, number> = {};
for (const slug of songs.flatMap((song) => song.data.songbooks)) {
  counts[slug] = (counts[slug] ?? 0) + 1;
}
---

<li data-songbooks-dim={Object.keys(counts).join(' ') || undefined}>
  <a href={href}>{label}</a>
  <span class="song-meta" data-songbooks-count="">
    {' '}
    — {t.songCount(songs.length)}
  </span>
  {Object.entries(counts).map(([slug, count]) => (
    <span class="song-meta" data-songbooks-count={slug}>
      {' '}
      — {t.songCount(count)}
    </span>
  ))}
</li>
