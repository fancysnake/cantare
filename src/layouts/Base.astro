---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { site, songbooks, themeCss } from '../lib/site';
import { OTHER, songbookCss, songbooksOf } from '../lib/songbook';
import { artistsHref, homeHref, languagesHref, songsHref, tagsHref } from '../lib/routes';
import { locale, t } from '../lib/i18n';

// "Other" is offered only when some song lands in it.
const hasOther =
  songbooks.length > 0 &&
  (await getCollection('songs')).some((song) => songbooksOf(song.data, songbooks).includes(OTHER));
const songbookOptions = [
  ...songbooks.map(({ slug, name }) => ({ slug, name })),
  ...(hasOther ? [{ slug: OTHER, name: t.songbookOther }] : []),
];
const songbookSlugs = songbookOptions.map(({ slug }) => slug);
const headStyles = [themeCss(), songbookCss(songbookSlugs)].filter(Boolean).join('\n');

interface Props {
  title?: string | undefined;
  description?: string | undefined;
  fullWidth?: boolean | undefined;
  pageClass?: string | undefined;
}

const {
  title,
  description = `${site.name} — ${site.description}`,
  fullWidth,
  pageClass,
} = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <script is:inline>
      // Apply forced theme and chord visibility before first paint.
      const storedTheme = localStorage.getItem('theme');
      if (storedTheme === 'light' || storedTheme === 'dark') {
        document.documentElement.dataset.theme = storedTheme;
      }
      if (localStorage.getItem('chords') === 'on') {
        document.documentElement.dataset.chords = 'on';
      }
      if (localStorage.getItem('focus') === 'on') {
        document.documentElement.dataset.focus = 'on';
      }
      if (localStorage.getItem('sheet-mode') === 'multi') {
        document.documentElement.dataset.sheetMode = 'multi';
      }
    </script>
    {songbookSlugs.length > 0 && <script is:inline define:vars={{ songbookSlugs }}>
      // A songbook since removed from the config falls back to all songs.
      const storedSongbook = localStorage.getItem('songbook');
      if (songbookSlugs.includes(storedSongbook)) {
        document.documentElement.dataset.songbook = storedSongbook;
      }
    </script>}
    {headStyles && <style is:inline set:html={headStyles}></style>}
  </head>
  <body class:list={[pageClass]}>
    <header class="site-header">
      <a href={homeHref()} class="brand">
        {site.name}
      </a>
      <nav aria-label={t.navLabel}>
        <a href={songsHref()}>{t.navAllSongs}</a>
        <a href={artistsHref()}>{t.navArtists}</a>
        <a href={tagsHref()}>{t.navTags}</a>
        <a href={languagesHref()}>{t.navLanguages}</a>
      </nav>
      {songbookOptions.length > 0 && (
        <select id="songbook-select" class="btn" aria-label={t.songbookLabel} hidden>
          <option value="">{t.songbookAll}</option>
          {songbookOptions.map(({ slug, name }) => (
            <option value={slug}>{name}</option>
          ))}
        </select>
      )}
      <button id="chords-toggle" class="btn" hidden>
        🎸
      </button>
      <button id="theme-toggle" class="btn" hidden>
        🌓
      </button>
    </header>
    <main class:list={[{ 'full-width': fullWidth }]}>
      <slot />
    </main>
    {site.footer && (
      <footer class="site-footer">
        {site.footer.href ? <a href={site.footer.href}>{site.footer.text}</a> : site.footer.text}
      </footer>
    )}
    <script>
      import { t } from '../lib/i18n';

      const toggle = document.getElementById('theme-toggle');
      if (toggle) {
        type Mode = 'system' | 'light' | 'dark';
        const LABELS: Record<Mode, string> = {
          system: t.themeAuto,
          light: t.themeLight,
          dark: t.themeDark,
        };
        const WORDS: Record<Mode, string> = {
          system: t.themeAutoWord,
          light: t.themeLightWord,
          dark: t.themeDarkWord,
        };
        const NEXT: Record<Mode, Mode> = { system: 'light', light: 'dark', dark: 'system' };
        const stored = localStorage.getItem('theme');
        let mode: Mode = stored === 'light' || stored === 'dark' ? stored : 'system';

        const apply = () => {
          if (mode === 'system') {
            delete document.documentElement.dataset.theme;
            localStorage.removeItem('theme');
          } else {
            document.documentElement.dataset.theme = mode;
            localStorage.setItem('theme', mode);
          }
          toggle.textContent = LABELS[mode];
          toggle.setAttribute('aria-label', t.themeAria(WORDS[mode]));
        };

        toggle.addEventListener('click', () => {
          mode = NEXT[mode];
          apply();
        });

        apply();
        toggle.hidden = false;
      }

      const chordsToggle = document.getElementById('chords-toggle');
      if (chordsToggle) {
        let chordsOn = localStorage.getItem('chords') === 'on';

        const applyChords = () => {
          if (chordsOn) {
            document.documentElement.dataset.chords = 'on';
            localStorage.setItem('chords', 'on');
            chordsToggle.textContent = t.withChords;
          } else {
            delete document.documentElement.dataset.chords;
            localStorage.setItem('chords', 'off');
            chordsToggle.textContent = t.withoutChords;
          }
          chordsToggle.setAttribute('aria-pressed', String(chordsOn));
          chordsToggle.setAttribute('aria-label', chordsOn ? t.chordsShown : t.chordsHidden);
        };

        chordsToggle.addEventListener('click', () => {
          chordsOn = !chordsOn;
          applyChords();
        });

        applyChords();
        chordsToggle.hidden = false;
      }

      const songbookSelect = document.getElementById('songbook-select');
      if (songbookSelect instanceof HTMLSelectElement) {
        songbookSelect.value = document.documentElement.dataset.songbook ?? '';
        songbookSelect.addEventListener('change', () => {
          const slug = songbookSelect.value;
          if (slug) {
            document.documentElement.dataset.songbook = slug;
            localStorage.setItem('songbook', slug);
          } else {
            delete document.documentElement.dataset.songbook;
            localStorage.removeItem('songbook');
          }
          document.dispatchEvent(new CustomEvent('songbook:changed'));
        });
        songbookSelect.hidden = false;
      }
    </script>
  </body>
</html>
